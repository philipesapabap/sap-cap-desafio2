  key reserva.ordem.ID as ordem_ID,
      count(*) as totalReservas,
      sum(reserva.quantidadeNecessaria) as quantidadeTotal
} group by reserva.ordem.ID;

view V_AcessosOrdem as select from ResponsabilidadesOrdem as responsabilidade {
  key responsabilidade.ordem.ID as ordem_ID,
