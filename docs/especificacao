## 7. Implementar handlers

Crie srv/planejamento-service.js.

### Comece com esta estrutura

```javascript
const cds = require("@sap/cds");
const { SELECT, UPDATE, INSERT } = cds.ql;
module.exports = class PlanejamentoService extends cds.ApplicationService {
  async init() {
    const { Ordens, LotesLiberacao } = this.entities;

    this.before("READ", Ordens, this.aplicarEscopoDeLeitura);
    this.before("READ", Ordens, this.aplicarFiltroDeRiscoEstoque);

    this.before(["CREATE", "UPDATE"], Ordens.drafts, this.validarPeriodoDaOrdem);
    this.before("SAVE", Ordens, this.validarOrdemAntesDeSalvar);

    this.on("liberarOrdem", Ordens, this.liberarOrdem);
    this.on("cancelarOrdem", Ordens, this.cancelarOrdem);
    this.on("processarLote", LotesLiberacao, this.processarLote);

    return super.init();
  }
};
```

### Ponto importante

- Use funções nomeadas.
- Evite handlers anônimos para facilitar debug.
- Os métodos são chamados com this transacional.

## 8. Handler before: validação simples

Implemente validarPeriodoDaOrdem.

### Regras

- dataInicioPlanejada é obrigatória.
- dataFimPlanejada é obrigatória.
- fim deve ser maior que início.
- valorEstimado não pode ser negativo.

### Exemplo

```javascript
validarPeriodoDaOrdem(req) {
  const inicio = req.data.dataInicioPlanejada;
  const fim = req.data.dataFimPlanejada;

  if (inicio && fim && new Date(fim) <= new Date(inicio))
    req.error(400, "Fim planejado deve ser maior que início planejado", "dataFimPlanejada");

  if (req.data.valorEstimado < 0)
    req.error(400, "Valor estimado não pode ser negativo", "valorEstimado");
}
```

