## Alterações no schema — resumo consolidado

```cds
// Novos tipos de ordem
entity TiposOrdem { key code: String(20); texto: String(80) not null; }

// Status da execução de manutenção
entity StatusManutencao { key code: String(20); texto: String(80) not null; }

// Motivos estruturados de parada
entity TiposParadaManutencao { key code: String(30); texto: String(80) not null; }

// Alterações em Materiais
@assert.unique: { codigo: [codigo] }
entity Materiais : cuid {
    codigo     : String(30) not null;
    descricao  : localized String(120) not null;
    unidade    : String(3) default 'UN';
    precoMedio : Decimal(13, 2) default 0;
    ativo      : Boolean default true;
}

annotate Estoques with @assert.unique: {
    materialDeposito: [material, deposito]
};

// Alterações em Ordens
entity Ordens : cuid, managed {
    codigo              : String(30) not null;
    descricao           : String(160) not null;
    centro              : Association to Centros not null;
    localInstalacao     : Association to LocaisInstalacao not null;
    responsavel         : Association to Usuarios not null;
    status              : Association to StatusOrdem default 'ABERTA';
    prioridade          : Association to Prioridades default 'MEDIA';
    dataInicioPlanejada : DateTime not null;
    dataFimPlanejada    : DateTime not null;
    valorEstimado       : Decimal(13, 2) default 0;
    observacao          : String(500);
    reservas            : Composition of many ReservasMateriais
                              on reservas.ordem = $self;
    responsabilidades   : Composition of many ResponsabilidadesOrdem
                              on responsabilidades.ordem = $self;
    tipo              : Association to TiposOrdem not null default 'MANUTENCAO';
    ordemOrigem       : Association to Ordens;
    itensMovimentacao : Composition of many ItensMovimentacaoEstoque
                            on itensMovimentacao.ordem = $self;
    liberacoes        : Composition of many LiberacoesOrdem
                            on liberacoes.ordem = $self;
    movimentos        : Association to many MovimentosEstoque
                            on movimentos.ordem = $self;
    ordensRelacionadas: Association to many Ordens on ordensRelacionadas.ordemOrigem = $self;
    grupoOrdem_ID     : UUID = coalesce(ordemOrigem.ID, ID);
    grupoOrdemCodigo  : String(30) = coalesce(ordemOrigem.codigo, codigo);
    ordemNoGrupo      : Integer = case
                                     when ordemOrigem is null then 0
                                     else 1
                                 end;
}

// Alterações nas reservas de manutenção
entity ReservasMateriais : cuid, managed {
    ordem                  : Association to Ordens not null;
    material               : Association to Materiais not null;
    deposito               : Association to Depositos not null;
    quantidadeNecessaria   : Decimal(13, 3) not null;
    quantidadeLiberada     : Decimal(13, 3) default 0 @readonly;
    quantidadeMinimaInicio : Decimal(13, 3);
    quantidadePendente     : Decimal(13, 3) =
        quantidadeNecessaria - quantidadeLiberada;
}

// Histórico de cada solicitação atômica de liberação
@assert.unique: { ordemNumero: [ordem, numero] }
entity LiberacoesOrdem : cuid, managed {
    ordem         : Association to Ordens not null;
    numero        : Integer not null;
    concluiuOrdem : Boolean default false;
    itens         : Composition of many ItensLiberacaoOrdem
                        on itens.liberacao = $self;
}

@assert.unique: { liberacaoReserva: [liberacao, reserva] }
entity ItensLiberacaoOrdem : cuid {
    liberacao : Association to LiberacoesOrdem not null;
    reserva   : Association to ReservasMateriais not null;
    quantidade: Decimal(13, 3) not null @assert.range: [0.001, 100000];
}

extend MovimentosEstoque with {
    itemLiberacao : Association to ItensLiberacaoOrdem;
}

// Itens exclusivos de RECEBIMENTO e ESTORNO
entity ItensMovimentacaoEstoque : cuid, managed {
    ordem               : Association to Ordens not null;
    material            : Association to Materiais not null;
    deposito            : Association to Depositos not null;
    quantidade          : Decimal(13, 3) not null @assert.range: [0.001, 100000];
    itemLiberacaoOrigem : Association to ItensLiberacaoOrdem;
}

// Nova entidade
@assert.unique: { ordem: [ordem] }
entity Manutencao : cuid, managed {
    codigo             : String(30) not null;
    descricao          : String(160);
    ordem              : Association to Ordens not null;
    localInstalacao    : Association to LocaisInstalacao not null;
    status             : Association to StatusManutencao not null default 'PLANEJADA';
    dataInicioPlanejada: DateTime not null;
    dataFimPlanejada   : DateTime not null;
    dataInicioReal     : DateTime;
    dataFimReal        : DateTime;
    motivoCancelamento : String(500);
    tecnicoResponsavel : Association to Usuarios not null;
    observacao         : String(500);
    paradas            : Composition of many ParadasManutencao
                             on paradas.manutencao = $self;
}

entity ParadasManutencao : cuid, managed {
    manutencao               : Association to Manutencao not null;
    tipo                     : Association to TiposParadaManutencao not null;
    motivo                   : String(500) not null;
    numeroLiberacaoReferencia: Integer default 0;
    dataRetomada             : Timestamp;
    retomadaPor              : Association to Usuarios;
}
```

